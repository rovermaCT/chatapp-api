{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=chatapp.db"
  },
  "Jwt": {
    "Issuer": "https://localhost:7129",
    "Audience": "chatapp-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "ExternalAuth": {
    "AuthorizationCodeLifetimeSeconds": 60,
    "AllowedRedirectUris": [
      "http://localhost:3000/auth/callback"
    ],
    "Providers": {
      "Google": {
        "DisplayName": "Google",
        "Authority": "https://accounts.google.com",
        "ClientId": "",
        "ClientSecret": ""
      },
      "Microsoft": {
        "DisplayName": "Microsoft",
        "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
        "ClientId": "",
        "ClientSecret": ""
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  }
}
